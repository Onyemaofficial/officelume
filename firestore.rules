rules_version = '2';

// OfficeLume Firestore security rules
// ---------------------------------------------------------------------------
// Principle: DENY by default, allow only what is explicitly needed.
//
//  * Customers are anonymous and never touch Firestore directly. Every customer action
//    (chat, service request, escalation) goes through a callable Cloud Function that validates
//    input, rate limits, writes with the Admin SDK, and records an audit event.
//
//  * There is NO client write access to any collection, for anyone - including staff and admins.
//    Status updates, notes, knowledge edits, and staff-account changes all go through Cloud
//    Functions, which validate, authorize, and audit them. This is what stops a staff member from
//    promoting themselves: `users/{uid}.role` and `.active` cannot be written from a browser at all.
//
//  * Roles: "staff" and "admin".
//      staff : read service requests + escalations (to work the queue)
//      admin : everything staff can, plus knowledge base, chat logs, audit log, staff directory
//
//  * A role is honoured only when BOTH are true:
//      1. the ID token carries the matching `role` custom claim (set only by the Admin SDK), and
//      2. users/{uid} exists, is `active == true`, and its `role` equals the claim.
//    The profile check lets an account be revoked immediately (active=false), and makes a role
//    change fail closed: a stale claim no longer matches the profile until the token refreshes.
//
//  * counters/ and rateLimits/ are server-internal and completely closed to clients.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasActiveProfileMatching(claimRole) {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && profile().active == true
        && profile().role == claimRole;
    }

    // Any active staff member or administrator.
    function isStaff() {
      return isSignedIn()
        && (request.auth.token.role == 'staff' || request.auth.token.role == 'admin')
        && hasActiveProfileMatching(request.auth.token.role);
    }

    // Administrators only.
    function isAdmin() {
      return isSignedIn()
        && request.auth.token.role == 'admin'
        && hasActiveProfileMatching('admin');
    }

    // A signed-in user reads only their own profile; administrators may read every profile
    // (staff management). Nobody writes profiles from a client.
    match /users/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if false;
    }

    // Approved HVAC knowledge (admin-managed). Customers get answers via askOfficeLume.
    match /knowledgeBase/{articleId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // The work queue: visible to all staff.
    match /serviceRequests/{requestId} {
      allow read: if isStaff();
      allow write: if false;
    }

    match /escalations/{escalationId} {
      allow read: if isStaff();
      allow write: if false;
    }

    match /chatSessions/{sessionId} {
      allow read: if isAdmin();
      allow write: if false;

      match /messages/{messageId} {
        allow read: if isAdmin();
        allow write: if false;
      }
    }

    match /auditLogs/{eventId} {
      allow read: if isAdmin();
      allow write: if false; // append-only from Cloud Functions; immutable to clients
    }

    // Server-internal bookkeeping (reference-number counters, rate-limit buckets).
    match /counters/{doc} {
      allow read, write: if false;
    }
    match /rateLimits/{doc} {
      allow read, write: if false;
    }

    // Anything not matched above is denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
