{
  "name": "officelume",
  "private": true,
  "version": "1.0.0",
  "description": "OfficeLume - AI-assisted digital front office for a small HVAC service business.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "functions:install": "npm --prefix functions install",
    "functions:build": "npm --prefix functions run build",
    "functions:test": "npm --prefix functions test",
    "test:all": "npm test && npm run functions:test && npm run test:rules && npm run test:integration",
    "emulators": "firebase emulators:start --project demo-officelume",
    "seed": "tsx scripts/seed/seed.ts",
    "admin:create": "tsx scripts/seed/grant-admin.ts",
    "docs:scenarios": "tsx scripts/seed/generate-scenario-doc.ts",
    "ai:evaluate": "tsx scripts/seed/evaluate-ai.ts",
    "deploy": "npm run build && npm run functions:build && firebase deploy",
    "test:rules": "firebase emulators:exec --only firestore --project demo-officelume \"vitest run --config vitest.rules.config.ts\"",
    "test:integration": "firebase emulators:exec --only firestore --project demo-officelume \"npm --prefix functions run test:integration\"",
    "smoke": "firebase emulators:exec --only auth,functions,firestore --project demo-officelume \"tsx scripts/smoke-emulator.ts\""
  },
  "dependencies": {
    "firebase": "^12.19.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "firebase-admin": "^14.4.0",
    "firebase-tools": "^15.30.2",
    "globals": "^17.12.0",
    "jsdom": "^29.1.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
