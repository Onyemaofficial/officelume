# ------------------------------------------------------------------
# OfficeLume - browser (Vite) environment
# Copy to .env.local and fill in from:
#   Firebase Console > Project settings > General > Your apps > Web app
# Vite only loads .env / .env.local (NOT this .env.example file).
# These are PUBLIC identifiers, not secrets. Security comes from Firestore
# rules + Cloud Functions, never from hiding these values.
# ------------------------------------------------------------------
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Region of the deployed Cloud Functions (must match functions/src/shared/config.ts)
VITE_FUNCTIONS_REGION=us-central1

# Set to "true" to talk to the local Firebase Emulator Suite instead of production
VITE_USE_EMULATORS=false

# ------------------------------------------------------------------
# DO NOT put ANTHROPIC_API_KEY in this file. It is server-side only.
#   Production : firebase functions:secrets:set ANTHROPIC_API_KEY
#   Emulator   : functions/.secret.local  (git-ignored, see functions/.secret.local.example)
# ------------------------------------------------------------------
